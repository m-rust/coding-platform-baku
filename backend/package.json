{
  "name": "baku-backend",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test \"src/test/**/*.js\"",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "generate": "prisma generate",
    "sandbox:build": "docker build -f docker/Dockerfile.python -t python-sandbox docker && docker build -f docker/Dockerfile.cpp -t cpp-sandbox docker && docker build -f docker/Dockerfile.node -t node-sandbox docker"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "prisma": "^5.22.0",
    "uuid": "^13.0.0"
  }
}
